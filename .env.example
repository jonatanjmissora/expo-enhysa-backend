# Backend — variables SECRETAS (cargar en el panel de Vercel)

DATABASE_URL=
API_TOKEN=

# Web (Better Auth) — URL pública del frontend/API web
# Local: http://localhost:3000 (el backend debe correr en la misma máquina)
# Producción: https://enhysav2.netlify.app
WEB_AUTH_URL=https://enhysav2.netlify.app

# Mercado Pago (se usan más adelante)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MP_ENV=sandbox

# URL pública del backend (para notification_url / back_urls)
BACKEND_BASE_URL=
APP_DEEP_LINK=expoenhysa://pago

# Reset de contraseña
RESEND_API_KEY=
EMAIL_FROM=
APP_RESET_DEEP_LINK=expoenhysa://auth/reset-password
